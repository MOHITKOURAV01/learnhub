MONGO_URI=mongodb://localhost:27017/learnhub
PORT=5000
NODE_ENV=development

# Signs and verifies every token, for both user and admin sessions.
# The server refuses to issue admin tokens when this is unset.
JWT_SECRET=your_jwt_secret_here

FRONTEND_URL=http://localhost:5173,http://localhost:5174
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=your_email@gmail.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
APP_NAME=learnhub
APP_VERSION=1.0.0
SEED_ADMIN_EMAIL=learn@learnhub.com
SEED_ADMIN_PASSWORD=changethispassword

# Credentials for POST /api/admin/login. These used to be hardcoded as
# admin / admin123 in controllers/adminController.js.
ADMIN_USERNAME=admin
# Preferred: a bcrypt hash. Generate one with
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=
# Local development fallback, used only when ADMIN_PASSWORD_HASH is empty.
# Ignored when NODE_ENV=production.
ADMIN_PASSWORD=changethispassword

# Course video upload limits
# Maximum size of each section video in MB (default: 250)
MAX_VIDEO_SIZE_MB=250
# Maximum section videos per course request (default: 20)
MAX_SECTION_VIDEOS=20

# Credential endpoint protection (login, register, OTP, password reset)
# Length of the per-client rate limit window in minutes (default: 15)
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
# Requests allowed per client per window on each credential endpoint (default: 20)
AUTH_RATE_LIMIT_MAX_REQUESTS=20
# Failed attempts allowed against one account before it is locked (default: 5)
AUTH_MAX_FAILED_ATTEMPTS=5
# How long failed attempts are remembered, in minutes (default: 15)
AUTH_FAILED_ATTEMPT_WINDOW_MINUTES=15
# How long a locked account stays locked, in minutes (default: 15)
AUTH_LOCKOUT_MINUTES=15
